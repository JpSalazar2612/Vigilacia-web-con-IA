# Copia a .env y ajusta a tu red/WiFi
# IP del ESP32-CAM (la muestra el Monitor Serie al arrancar)
ESP32_STREAM_URL=http://192.168.1.50/stream
ESP32_BASE_URL=http://192.168.1.50
# Tu Laravel (local o en red). Si Python corre en otro PC de la red, usa la IP LAN, ej: http://192.168.1.20:8000/api/v1
API_BASE_URL=http://localhost:8000/api/v1
# Token Sanctum: curl -X POST http://localhost:8000/api/v1/login -H "Content-Type: application/json" -d "{\"email\":\"...\",\"password\":\"...\"}"
API_TOKEN=
# ID de la cámara creada a mano en el Dashboard (normalmente 1)
CAMERA_ID=1
# Línea de perímetro 0-1 (0.60 = 60%, barda de la maqueta 35x30)
FENCE_Y=0.60
# Confianza mínima YOLO clase person (baja a 0.35 si las figuras salen pequeñas)
YOLO_CONF=0.50
# Tamaño de inferencia (480 = equilibrio velocidad/maqueta pequeña.
# Sube a 640-960 para figuras pequeñas, baja a 416 si tu PC es lento)
YOLO_IMGSZ=480
# Procesa 1 de cada N frames (N=2 duplica FPS, reutiliza cajas intermedias)
YOLO_FRAME_SKIP=2
YOLO_MODEL=yolov8n.pt
# --- Retransmisor (evita saturar la ESP32 con 2 visores) ---
# Con PROXY_PORT puesto, vigilancia_yolo.py retransmite solo:
#   ESP32 -> http://localhost:8080/stream -> leen YOLO + navegador + celular
# y la ESP32 solo atiende 1 petición corta a la vez. Vacío = desactivado (YOLO lee directo).
PROXY_PORT=8080
# Buzzer/LED físico de la maqueta vía GET http://ESP32/beep
BUZZER_FISICO=true
# Token del Device Blynk (el mismo de tu .env Laravel). Si se pone, Python
# hace latido HTTP V3=1 y el LED "sistema activo" queda encendido.
# (La sesión hardware TLS :443 está bloqueada en esta red: el badge nativo
# "online" quedará en offline, es cosmético; pines y V4 por API siguen OK.)
BLYNK_TOKEN=
BLYNK_SERVER=blynk.cloud
# http por defecto: https a blynk.cloud:443 se cuelga en redes compartidas.
BLYNK_SCHEME=http
# Cada cuántos segundos relee V4/perímetro en hilo fondo (no congela video)
POLL_SEGUNDOS=10
# Cada cuántos segundos refresca V3=1 (LED sistema activo en la app)
BLYNK_HEARTBEAT_SEG=60
# Pin switch Armar/Desarmar en Blynk (Integer). YOLO lo lee cada 5 s:
# 1 = detecta y alerta, 0 = solo video. Sin red se asume armada.
BLYNK_ARMA_PIN=V4
